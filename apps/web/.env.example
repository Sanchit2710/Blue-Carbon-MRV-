# Supabase dashboard -> Connect -> Next.js. Public values only; never add the service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sepolia (see contracts/deployments/sepolia.json). Public values:
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
# Server-only (no NEXT_PUBLIC_): used to re-check transaction receipts. Contains your Alchemy key.
SEPOLIA_RPC_URL=

# Server-only secret (Supabase -> Project Settings -> API Keys -> Secret keys, starts with sb_secret_).
# Bypasses RLS: used only to record listings, purchases and retirements AFTER the server confirms them on-chain.
SUPABASE_SECRET_KEY=
